# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# OpenAI key used by the answer pipeline
OPENAI_API_KEY=

# --- server only (docker-compose.yml) ---
# Address the phone app connects to, e.g. 203-0-113-7.sslip.io (your server's IP with dashes) or your own domain
DOMAIN=
# Web site address (website/), e.g. darg.network, www.darg.network. Leave empty for no web site.
SITE_DOMAIN=
# "https" starts Caddy (ports 80/443, automatic certificate). Leave empty if those ports are already used
# on the server and set API_BIND=0.0.0.0 to reach the API on port 8000 instead.
COMPOSE_PROFILES=https
API_BIND=127.0.0.1

# --- request limits (src/api/limits.py); they keep the OpenAI bill bounded on a public server ---
# Per client address: questions per minute and per day
KISI_DAKIKA_SORU=5
KISI_GUNLUK_SORU=30
# Whole service, per day: questions, and web searches (past this, answers use the AFAD documents only)
GUNLUK_SORU_TAVANI=150
GUNLUK_WEB_TAVANI=40
# Answers written at the same time (the rest wait up to 30 seconds)
ES_ZAMANLI_SORU=3
# Note: with API_BIND=0.0.0.0 and no Caddy, clients can fake their address; the daily caps still hold.
