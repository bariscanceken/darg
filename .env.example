# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# OpenAI key used by the answer pipeline
OPENAI_API_KEY=

# --- server only (docker-compose.yml) ---
# Address the phone app connects to, e.g. 203-0-113-7.sslip.io (your server's IP with dashes) or your own domain
DOMAIN=
# "https" starts Caddy (ports 80/443, automatic certificate). Leave empty if those ports are already used
# on the server and set API_BIND=0.0.0.0 to reach the API on port 8000 instead.
COMPOSE_PROFILES=https
API_BIND=127.0.0.1
